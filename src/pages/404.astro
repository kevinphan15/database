---
import Base from '../layouts/Base.astro';
import { decideIndex } from '../lib/policy';

Astro.response.status = 404;
const decision = { index: false, follow: false, reason: 'trang 404' };
---

<Base
  title="Không tìm thấy trang"
  description="Đường dẫn không tồn tại."
  decision={decision}
  canonicalPath={null}
>
  <h1>Không tìm thấy trang</h1>
  <p class="lede">
    Đường dẫn này không tồn tại hoặc đã thay đổi. <a href="/">Về trang chủ</a>.
  </p>
</Base>
